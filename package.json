{
  "name": "@netfeez/common",
  "type": "module",
  "version": "3.3.0",
  "description": "The universal core of the NetFeez ecosystem. Agnostic utilities and schema validation for Vortez (Server) and Vizui (Web).",
  "license": "Apache-2.0",
  "main": "build/common.js",
  "exports": {
    ".": { "import": "./build/common.js" },
    "./schema": { "import": "./build/schema/index.js" },
    "./*": { "import": "./build/*" }
  },
  "author": {
    "name": "NetFeez",
    "email": "netfeez.dev@gmail.com",
    "url": "https://github.com/NetFeez"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NetFeez/common.git"
  },
  "scripts": {
    "publish": "bash scripts/publish.sh",
    "build": "bash scripts/build.sh",
    "dev": "bash scripts/dev.sh",
    "dev.publish": "bash scripts/publish.sh --dev"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "build"
  ],
  "devDependencies": {
    "typescript": "^6.0.3"
