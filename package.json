{
  "name": "@netfeez/common",
  "type": "module",
  "version": "4.1.1",
  "description": "The universal core of the NetFeez ecosystem. Agnostic utilities and schema validation for Vortez (Server) and Vizui (Web).",
  "license": "Apache-2.0",
  "main": "build/common.js",
  "exports": {
    ".": { "import": "./build/common.js", "types": "./build/common.d.ts" },
    "./*": { "import": "./build/*", "types": "./build/*" }
  },
  "author": {
    "name": "NetFeez",
    "email": "netfeez.dev@gmail.com",
    "url": "https://github.com/NetFeez"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NetFeez/common.git"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bash scripts/build.sh",
    "release": "bash scripts/release.sh",
    "release:dev": "bash scripts/release.sh --dev",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "build"
  ],
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
